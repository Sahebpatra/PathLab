@{
    ViewData["Title"] = "Add New Test";
}

<link href="~/css/tests/add-test.css" rel="stylesheet" />
<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between">
            <span><strong>Add New Test</strong></span>
            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa fa-paper-plane" aria-hidden="true"></i>Submit</button>
        </div>
    </div>
    <div class="card-body">
        <div id="add-test-form-container">
            <form id="addTestForm">
                <div class="row mb-3">
                    <div class="col-sm-12 col-md-4 col-lg-3 mt-4">
                        <label for="TestType" class="form-label">Test Type</label>
                        <custom-dropdown name="TestType" id="TestType" lab-id="1" required>
                            <option value="0" selected>Default</option>
                        </custom-dropdown>
                    </div>
                    <div class="col-sm-12 col-md-4 col-lg-3 mt-4">
                        <label for="Department" class="form-label">Department</label>
                        <custom-dropdown class="select2" name="Department" id="Department" lab-id="1" required></custom-dropdown>
                    </div>
                    <div class="col-sm-12 col-md-4 col-lg-3 mt-4">
                        <label for="TestDesc" class="form-label">Test Name</label>
                        <input type="text" class="form-control" id="TestDesc" name="TestDesc" required />
                    </div>
                    <div class="col-sm-12 col-md-4 col-lg-3 mt-4">
                        <label for="TestCode" class="form-label">Test Code</label>
                        <input type="text" class="form-control" id="TestCode" name="TestCode" required />
                    </div>
                    <div class="col-sm-12 col-md-4 col-lg-3 mt-4">
                        <label for="Price" class="form-label">Price</label>
                        <input type="number" class="form-control" id="Price" name="Price" required />
                    </div>
                    <div class="col-sm-12 col-md-4 col-lg-3 mt-4">
                        <label for="BarCodeSuffix" class="form-label">Bar Code Suffix</label>
                        <input type="text" class="form-control" id="BarCodeSuffix" name="BarCodeSuffix" required />
                    </div>
                    <div class="col-sm-12 col-md-4 col-lg-3 mt-4">
                        <label for="Sample" class="form-label">Sample</label>
                        <custom-dropdown name="Sample" id="Sample"></custom-dropdown>                    
                    </div>
                    <div class="col-sm-12 col-md-4 col-lg-3 mt-4">
                        <label for="SampleColor" class="form-label">Sample Color</label>
                        <custom-dropdown name="SampleColor" id="SampleColor"></custom-dropdown>
                    </div>
                    <div class="col-sm-12 col-md-4 col-lg-3 mt-4">
                        <label for="test-price" class="form-label col-12">Gender</label>
                        <div class="col-12">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="Gender" id="chkMale" checked>
                                <span class="form-check-label" for="chkMale">
                                    Male
                                </span>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="Gender" id="chkFemale">
                                <span class="form-check-label" for="chkFemale">
                                    Female
                                </span>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="Gender" id="chkBoth">
                                <span class="form-check-label" for="chkBoth">
                                    Both
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-4 col-lg-4 mt-4">
                        <label class="form-label col-12">Required Field</label>
                        <div class="col-12">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="RequiredField" id="LMPRequired" checked>
                                <span class="form-check-label" for="LMPRequired">
                                    LMP Required
                                </span>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="RequiredField" id="IDRequired">
                                <span class="form-check-label" for="IDRequired">
                                    ID Required
                                </span>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="RequiredField" id="ConsentForm">
                                <span class="form-check-label" for="ConsentForm">
                                    Consent Form
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-4 col-lg-2 mt-4">
                        <label for="CollectionGuidline" class="form-label">Collection Guidline</label>
                        <div class="col-12">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="CollectionGuidline" id="PreCollectionGuidline_YES" checked>
                                <span class="form-check-label" for="PreCollectionGuidline_YES">
                                    Yes
                                </span>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="CollectionGuidline" id="PreCollectionGuidline_NO">
                                <span class="form-check-label" for="PreCollectionGuidline_NO">
                                    No
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-4 col-lg-3 mt-4">
                        <label for="Guidline_Attachment" class="form-label">Guidline Attachment</label>
                        <input type="file" class="form-control" id="GuidlineAttachment" name="GuidlineAttachment" required />
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8" style="overflow-y:auto;">
        <div class="card testlist">
            <div class="card-header">
                <div class="d-flex justify-content-between">
                    <span><strong>Child Test List</strong></span>
                </div>
            </div>
            <div class="card-body">
                <table class="table table-striped table-responsive">
                    <thead class="table-danger">
                        <tr>
                            <th>#</th>
                            <th>Field</th>
                            <th>Name</th>
                            <th>Unit</th>
                            <th>Range</th>
                            <th>Formula</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>Multiple</td>
                            <td>Blood Test</td>
                            <td>Numeric</td>
                            <td>13.5 - 17.5 g/dL</td>
                            <td>Yes</td>
                            <td><i class="fa fa-trash-alt text-danger"></i></td>
                        </tr>
                        <tr>
                            <td></td>
                            <td colspan="6">
                                <table class="table table-responsive">
                                    <tbody>
                                        <tr>
                                            <td>Single</td>
                                            <td>Blood Test</td>
                                            <td>Numeric</td>
                                            <td>13.5 - 17.5 g/dL</td>
                                            <td>Yes</td>
                                            <td><i class="fa fa-trash-alt text-danger"></i></td>
                                        </tr>
                                        <tr>
                                            <td>Single</td>
                                            <td>Blood Test</td>
                                            <td>Numeric</td>
                                            <td>13.5 - 17.5 g/dL</td>
                                            <td>Yes</td>
                                            <td><i class="fa fa-trash-alt text-danger"></i></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td>2</td>
                            <td>Single</td>
                            <td>Blood Test</td>
                            <td>Numeric</td>
                            <td>13.5 - 17.5 g/dL</td>
                            <td>Yes</td>
                            <td><i class="fa fa-trash-alt text-danger"></i></td>
                        </tr>
                        <tr>
                            <td>3</td>
                            <td>Single</td>
                            <td>Blood Test</td>
                            <td>Numeric</td>
                            <td>13.5 - 17.5 g/dL</td>
                            <td>Yes</td>
                            <td><i class="fa fa-trash-alt text-danger"></i></td>
                        </tr>
                    <tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <div class="d-flex justify-content-between">
                    <span><strong>Add Child Test</strong></span>
                    @* <button type="submit" class="btn btn-outline-secondary"><i class="fa fa-plus-square" aria-hidden="true"></i>add</button> *@
                </div>
            </div>
            <div class="card-body">
                <div class="mt-3">
                    <label>Field Type</label>
                    <select class="form-control " id="FieldType" name="FieldType">
                        <option>Single</option>
                        <option>Multiple</option>
                    </select>
                </div>
                <div class="mt-3">
                    <label>Test Method</label>
                    <input type="text" class="form-control" id="TestMethod" name="TestMethod" />
                </div>
                <div class="mt-3 d-flex justify-content-end">
                    <button class="btn btn-outline-danger"><i class="fa fa-file"></i>Save</button>
                </div>
                <hr />
                <div class="mt-3">
                    <label>Name</label>
                    <input type="text" class="form-control" id="TestName" name="TestName" />
                </div>
                <div class="mt-3">
                    <label>Test Method</label>
                    <input type="text" class="form-control" id="TestMethod" name="TestMethod" />
                </div>
                <div class="mt-3 row">
                    <div class="col-lg-6 col-md-6 col-sm-6">
                        <label>Field</label>
                        <custom-dropdown name="UnitFieldType" id="UnitFieldType"></custom-dropdown>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6">
                        <label>Unit</label>
                        <input type="text" class="form-control" id="Unit" name="Unit" />
                    </div>

                </div>
                
                <div class="row mt-3">
                    <label>Result</label>
                    <div class="col-lg-6 col-md-6 col-sm-6" id="divResultOperator">
                        <custom-dropdown name="Operator" id="Operator"></custom-dropdown>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6" id="divResultRangeMin">
                        <input type="text" class="form-control" id="ResultRangeMin" name="ResultRangeMin" />
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6">
                        <input type="text" class="form-control" id="ResultRangeMax" name="ResultRangeMax" />
                    </div>
                </div>
                <div class="row mt-3">
                    @* <div class="form-check form-check-inline">
                        <input type="checkbox" class="form-check-inline" id="CriticalRange" name="CriticalRange" />
                        <label class="form-check-label" for="CriticalRange">Critical Range</label>
                    </div> *@
                    <div class="form-check form-switch" style="margin-left: 10px;padding-left: 7px;">
                        <label class="form-check-label" for="CriticalRange">Critical Range</label>
                        <input class="form-check-input" type="checkbox" id="CriticalRange" name="CriticalRange" checked>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6">
                        <input type="text" class="form-control" id="CriticalRangeMin" name="CriticalRangeMin" />
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6">
                        <input type="text" class="form-control" id="CriticalRangeMax" name="CriticalRangeMax" />
                    </div>
                </div>

                <div class="mt-3 d-flex justify-content-end">
                    <button class="btn btn-outline-danger"><i class="fa fa-plus"></i>Add Field</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/tests/add-test.js"></script>
}


